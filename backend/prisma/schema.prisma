
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  projects Project[]
  assignedTasks Task[]
}

model Project {
  id Int @id @default(autoincrement())
  name String
  description String?
  createdAt DateTime @default(now())
  ownerId Int
  owner User @relation(fields: [ownerId], references: [id])
  tasks Task[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id Int @id @default(autoincrement())
  title String
  description String?
  status TaskStatus @default(TODO)
  dueDate DateTime?
  createdAt DateTime @default(now())
  projectId Int
  project Project @relation(fields: [projectId], references: [id])
  assigneeId Int?
  assignee User? @relation(fields: [assigneeId], references: [id])
}

